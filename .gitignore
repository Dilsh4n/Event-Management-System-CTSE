# ── Java / Maven ──────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.nar
*.ear
*.jar.original
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
.cache/
*.tsbuildinfo

# ── Log files ─────────────────────────────────────────────────────────────────
*.log
hs_err_pid*
replay_pid*

# ── IDE files ─────────────────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Environment variables — NEVER commit these ────────────────────────────────
.env
*.env
!.env.example
**/application-dev.yml

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Archive / compressed ─────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar

# ── Mobile Tools for Java ────────────────────────────────────────────────────
.mtj.tmp/
*.ctxt

# ── Docker ────────────────────────────────────────────────────────────────────
# PEM keys (SSH keys should never be committed)
*.pem
